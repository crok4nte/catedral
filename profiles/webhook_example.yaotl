Teamserver {
    Host = "0.0.0.0"
    Port = 40056
}

WebHook {
    Discord {
        # required
        Url = "..." # replace this with your webhook

        # optional
        AvatarUrl = "https://raw.githubusercontent.com/CatedralFramework/Catedral/main/assets/catedral-logo.svg" # url to an image to use as an avatar

        # optional
        User = "Catedral" # User name of the webhook bot
    }
}

Operators {
    user "5pider" {
        Password = "password1234"
    }

    user "Neo" {
        Password = "password1234"
    }
}

# this is optional. if you dont use it you can remove it.
Service {
    Endpoint = "service-endpoint"
    Password = "service-password"
}

Demon {
    Sleep = 2
    Jitter = 30

    TrustXForwardedFor = false

    Injection {
        Spawn64 = "C:\\Windows\\System32\\notepad.exe"
        Spawn32 = "C:\\Windows\\SysWOW64\\notepad.exe"
    }
}

